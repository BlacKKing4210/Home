# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Preserve binary assets and Office/PDF artifacts byte-for-byte.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
